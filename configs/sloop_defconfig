# sloop: full SLOOP (2nd-gen) firmware rebuild.
# Inherits Felucca engine set, adds SLOOP arranger/scenes sequencer.
# Not yet buildable: requires remaining SLOOP source integration.
CONFIG_FIRMWARE_NAME="core-fm1"

# HAL (SLOOP-specific where available, shared Felucca/Melodee otherwise)
CONFIG_HAL_SYS_SLOOP=y
CONFIG_HAL_IRQ_SLOOP=y
CONFIG_HAL_LCD_MELODEE=y
CONFIG_HAL_INPUT_SLOOP=y
CONFIG_HAL_GUARD_SLOOP=y
CONFIG_HAL_FLASH_SLOOP=y
CONFIG_HAL_UART_FELUCCA=y
CONFIG_HAL_USB_FELUCCA=y
CONFIG_HAL_TIMER_FELUCCA=y
CONFIG_HAL_MULTICORE_SLOOP=y

# Boot (SLOOP: stock DFU loader)
CONFIG_BOOT_SLOOP=y

# Audio (SLOOP core: inherited from Felucca, dual-core render)
CONFIG_AUDIO=y
CONFIG_DUAL_CORE=y
CONFIG_AUDIO_CORE_SLOOP=y

# Engines (Felucca set: 15 engines + modulation, SLOOP drum variant)
CONFIG_ENGINE_FM6=y
CONFIG_ENGINE_FM6_FELUCCA=y
CONFIG_ENGINE_DRUM=y
CONFIG_ENGINE_DRUM_SLOOP=y
CONFIG_ENGINE_ANALOG=y
CONFIG_ENGINE_DIGITAL=y
CONFIG_ENGINE_PHASE=y
CONFIG_ENGINE_SAMPLE=y
CONFIG_ENGINE_GRANULAR=y
CONFIG_ENGINE_LOFI=y
CONFIG_ENGINE_TRIO=y
CONFIG_ENGINE_TONEWHEEL=y
CONFIG_ENGINE_FORMANT=y
CONFIG_ENGINE_PHYSICAL=y
CONFIG_ENGINE_NOISE=y
CONFIG_MODULATION=y

# Effects (SLOOP variant)
CONFIG_EFFECTS_SLOOP=y

# Sequencer (SLOOP: arranger, scenes)
CONFIG_SEQ_SLOOP=y

# MIDI (SLOOP routing, UART + USB transports)
CONFIG_MIDI_UART=y
CONFIG_USB=y
CONFIG_MIDI_SLOOP=y

# UI (SLOOP page shell)
CONFIG_INPUT=y
CONFIG_UI_SLOOP=y
CONFIG_CONTROLS_SLOOP=y

# Storage (SLOOP: flash presets and projects)
CONFIG_FLASH=y
CONFIG_STORAGE_SLOOP=y

# Scales (uses Felucca: 16 scales, white-key quantize)
CONFIG_SCALES_FELUCCA=y
