CONFIG_FIRMWARE_NAME="core-fm1"
CONFIG_FIRMWARE_VERSION="v0.0.0"

#
# Engines
#
CONFIG_ENGINES=y

#
# Multi-upstream (require full audio core)
#
CONFIG_ENGINE_FM6=y
CONFIG_ENGINE_FM6_FMLAB=y
# CONFIG_ENGINE_FM6_FELUCCA is not set
# CONFIG_ENGINE_FM6_MELODEE is not set
# CONFIG_ENGINE_DRUM is not set

#
# Melodee
#
# CONFIG_ENGINE_PROPHET is not set
# CONFIG_ENGINE_CZ1 is not set
# CONFIG_ENGINE_SID is not set

#
# Felucca (MIT)
#
CONFIG_ENGINE_ANALOG=y
# CONFIG_ENGINE_DIGITAL is not set
# CONFIG_ENGINE_PHASE is not set
# CONFIG_ENGINE_SAMPLE is not set
# CONFIG_ENGINE_GRANULAR is not set
CONFIG_ENGINE_LOFI=y
CONFIG_ENGINE_TRIO=y
# CONFIG_ENGINE_TONEWHEEL is not set
# CONFIG_ENGINE_FORMANT is not set
# CONFIG_ENGINE_PHYSICAL is not set
CONFIG_ENGINE_NOISE=y

#
# Development
#
CONFIG_ENGINE_STUB=y
# end of Engines

#
# Effects
#
# CONFIG_EFFECTS_FELUCCA is not set
# CONFIG_EFFECTS_SLOOP is not set
CONFIG_EFFECTS_MELODEE=y
CONFIG_MODULATION=y
CONFIG_MOD_MELODEE=y
# CONFIG_MIX is not set
# end of Effects

#
# Sequencer
#
# CONFIG_SEQ_FELUCCA is not set
# CONFIG_SEQ_SLOOP is not set
CONFIG_SEQ_MELODEE=y
# end of Sequencer

#
# Scales
#
# CONFIG_SCALES_FELUCCA is not set
CONFIG_SCALES_MELODEE=y
# end of Scales

#
# System
#

#
# HAL
#

#
# Always included: fm1_adc.h, fm1_cc.h, fm1_gpio.h, fm1_xip.h, fm1_time.h
#
# CONFIG_HAL_SYS_FELUCCA is not set
# CONFIG_HAL_SYS_SLOOP is not set
CONFIG_HAL_SYS_MELODEE=y
# CONFIG_HAL_IRQ_FELUCCA is not set
# CONFIG_HAL_IRQ_SLOOP is not set
CONFIG_HAL_IRQ_MELODEE=y
# CONFIG_HAL_LCD_FELUCCA is not set
CONFIG_HAL_LCD_MELODEE=y
# CONFIG_HAL_INPUT_FELUCCA is not set
# CONFIG_HAL_INPUT_SLOOP is not set
CONFIG_HAL_INPUT_MELODEE=y
# CONFIG_HAL_GUARD_FELUCCA is not set
# CONFIG_HAL_GUARD_SLOOP is not set
CONFIG_HAL_GUARD_MELODEE=y
# CONFIG_HAL_FLASH_FELUCCA is not set
# CONFIG_HAL_FLASH_SLOOP is not set
CONFIG_HAL_FLASH_MELODEE=y
# CONFIG_HAL_UART_FELUCCA is not set
CONFIG_HAL_UART_MELODEE=y
# CONFIG_HAL_USB_FELUCCA is not set
CONFIG_HAL_USB_MELODEE=y
# CONFIG_HAL_TIMER_FELUCCA is not set
CONFIG_HAL_TIMER_MELODEE=y
# CONFIG_HAL_MULTICORE_FELUCCA is not set
# CONFIG_HAL_MULTICORE_SLOOP is not set
CONFIG_HAL_MULTICORE_MELODEE=y
CONFIG_HAL_MELODEE_CACHE=y
CONFIG_HAL_MELODEE_CLOCK=y
CONFIG_HAL_MELODEE_POWER=y
# end of HAL

#
# Boot
#
# CONFIG_BOOT_FELUCCA is not set
# CONFIG_BOOT_SLOOP is not set
CONFIG_BOOT_MELODEE=y
CONFIG_OTA=y
# end of Boot

#
# Audio
#
CONFIG_AUDIO=y
# CONFIG_DUAL_CORE is not set
# CONFIG_AUDIO_CORE_FELUCCA is not set
# CONFIG_AUDIO_CORE_SLOOP is not set
CONFIG_AUDIO_CORE_MELODEE=y
# CONFIG_AUDIO_24BIT is not set
# end of Audio

#
# MIDI
#
# CONFIG_MIDI_UART is not set
CONFIG_USB=y
# CONFIG_MIDI_FELUCCA is not set
# CONFIG_MIDI_SLOOP is not set
CONFIG_MIDI_MELODEE=y
# CONFIG_USB_AUDIO is not set
# CONFIG_EDITOR is not set
# CONFIG_CONSOLE is not set
# end of MIDI

#
# UI
#
CONFIG_INPUT=y
CONFIG_UI_FELUCCA=y
# CONFIG_UI_SLOOP is not set
# CONFIG_UI_CORE is not set
CONFIG_CONTROLS_FELUCCA=y
# CONFIG_CONTROLS_MELODEE is not set
# CONFIG_CONTROLS_SLOOP is not set
CONFIG_SPLASH_LOGO=y
# CONFIG_SPLASH_NONE is not set
CONFIG_GEN_FELUCCA_UI=y
# end of UI

#
# Storage
#
CONFIG_FLASH=y
# CONFIG_STORAGE_FELUCCA is not set
# CONFIG_STORAGE_SLOOP is not set
CONFIG_STORAGE_MELODEE=y
# end of Storage

#
# UDisk
#
CONFIG_USB_HOST=y
CONFIG_UDISK=y
# end of UDisk

#
# BLE
#
# CONFIG_BLE is not set
# end of BLE

#
# WiFi
#
CONFIG_WIFI=y
CONFIG_WIFI_LWIP=y
CONFIG_WIFI_WPA=y
CONFIG_WIFI_SSID=""
CONFIG_WIFI_PASSWORD=""
CONFIG_WIFI_AUTOJOIN=y
# CONFIG_WIFI_MIDI is not set
CONFIG_WIFI_MAC_OVERRIDE=""
CONFIG_WIFI_DEBUG_AUTOSCAN=y
CONFIG_WIFI_DEBUG_WLCTL0_PROBE=y
# CONFIG_WIFI_PROBES is not set
CONFIG_WIFI_T19_TEST=y
# end of WiFi

#
# CDP
#
# CONFIG_CDP is not set
# end of CDP

#
# Debug
#
CONFIG_DEBUG=y
CONFIG_DEBUG_LOG=y
CONFIG_DEBUG_DAP=y
# end of Debug

#
# Settings Menu
#
CONFIG_SYS_MENU=y
CONFIG_SETTINGS_FMLAB=y
# CONFIG_SETTINGS_FELUCCA is not set
# CONFIG_SETTINGS_NONE is not set
CONFIG_SETTINGS_AT=0xFC000
CONFIG_SYS_MENU_USB_MODE=y
CONFIG_SYS_MENU_MIDI_CH=y
# end of Settings Menu

#
# Scheduler
#
CONFIG_SCHED=y
CONFIG_SCHED_MAX_TASKS=6
CONFIG_SCHED_STACK_CANARY=y
# end of Scheduler
# end of System
