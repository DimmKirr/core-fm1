menu "UI"

config INPUT
    bool "Panel input"
    default n

choice
    prompt "UI framework"
    depends on INPUT
    default UI_MELODEE

config UI_FELUCCA
    bool "Felucca"

config UI_SLOOP
    bool "SLOOP"

config UI_MELODEE
    bool "Melodee"
    help
      Rubik font, track colors, 8 palettes, partial screen updates.

endchoice

endmenu
