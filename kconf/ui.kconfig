menu "UI"

config INPUT
    bool "Panel input"
    default n

choice
    prompt "UI framework"
    depends on INPUT
    default UI_MELODEE

config UI_FELUCCA
    bool "Felucca"
    select GEN_FELUCCA_UI
    help
      SURF cards, Inter Tight font, anti-aliased icons, knob arcs.

config UI_SLOOP
    bool "SLOOP"

config UI_MELODEE
    bool "Melodee"
    help
      Rubik font, track colors, 8 palettes, partial screen updates.

endchoice

config GEN_FELUCCA_UI
    bool
    help
      Hidden. Selected by UI_FELUCCA. Tells the build system to run
      Felucca font/icon/keycap/palette generators before compiling.

endmenu
