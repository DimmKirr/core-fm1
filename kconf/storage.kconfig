menu "Storage"

config FLASH
    bool "Application flash storage"
    default n

choice
    prompt "Storage implementation"
    depends on FLASH
    default STORAGE_MELODEE

config STORAGE_FELUCCA
    bool "Felucca"

config STORAGE_SLOOP
    bool "SLOOP"

config STORAGE_MELODEE
    bool "Melodee"
    help
      FBKG format, 384 shared presets, migration, backup/restore.

endchoice

endmenu
