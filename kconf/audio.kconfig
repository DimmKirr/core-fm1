menu "Audio Core"

config AUDIO
    bool "Enable audio subsystem"
    default n

config DUAL_CORE
    bool "Dual-core voice dispatch"
    default n
    depends on AUDIO

choice
    prompt "Audio core lineage"
    depends on AUDIO
    default AUDIO_CORE_MELODEE

config AUDIO_CORE_FELUCCA
    bool "Felucca (8+6 voices)"

config AUDIO_CORE_SLOOP
    bool "SLOOP"

config AUDIO_CORE_MELODEE
    bool "Melodee (18 budget units, FPU)"

endchoice

endmenu
