menu "Scales & Tuning"

choice
    prompt "Scale system"
    default SCALES_MELODEE

config SCALES_FELUCCA
    bool "Felucca scales"
    help
      16 scales, white-key QNT.

config SCALES_MELODEE
    bool "Melodee scales"
    help
      70 scales incl. 54 microtonal, concert pitch 400-480Hz.

endchoice

endmenu
